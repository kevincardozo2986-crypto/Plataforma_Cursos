PORT=3000
# En el servidor: NODE_ENV=production (valida secreto, APP_URL y CORS al arrancar).
# NODE_ENV=production
# Solo IPs/CIDRs de los proxies reales, nunca "true" ni una red pública completa.
# Nginx en la misma máquina: TRUSTED_PROXIES=loopback
# TRUSTED_PROXIES=loopback
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/db_plataforma_cursos?schema=public"
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
# Administrador inicial: se crea al arrancar solo si el correo no existe todavía.
# Si falta ADMIN_PASSWORD en producción, no se crea (evita una clave conocida en el servidor).
# ADMIN_BOOTSTRAP=false
# ADMIN_EMAIL=admin@campus.com
# ADMIN_PASSWORD=Admin2026*
# ADMIN_FIRST_NAME=Administrador
# ADMIN_LAST_NAME=Campus
# ADMIN_DOCUMENT=ADMIN-0001
# Public address of the web app (no trailing slash). Printed on certificates as the
# verification link: <APP_URL>/verificar/<code>. Default: http://localhost:4200
# APP_URL=https://campus.example.com/cursos-virtuales
# Allowed browser origins, comma-separated, WITHOUT a path. Default: http://localhost:4200
# CORS_ORIGINS=https://campus.example.com
# Optional: enable NestJS Observe only when both credentials are supplied.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# --- Uploaded media (all optional; the defaults below are used when unset) ---
# Where uploaded files are stored. Default: ./uploads (keep it OUT of git; on a server use a
# separate volume and back it up).
# UPLOADS_DIR=./uploads

# Videos are re-encoded to H.264/AAC MP4 with ffmpeg in a background queue (one at a time).
# Linux: `apt install ffmpeg` and leave FFMPEG_PATH unset (ffmpeg is found in PATH).
# Windows: download ffmpeg and point to ffmpeg.exe, e.g. C:\ffmpeg\bin\ffmpeg.exe
# Without ffmpeg the app still works: videos are stored as uploaded (not compressed).
# FFMPEG_PATH=ffmpeg
# VIDEO_MAX_HEIGHT=720        # pixels; larger videos are scaled down, smaller ones are kept
# VIDEO_CRF=28                # quality: higher = smaller file (23 = good, 28 = light, 32 = very light)
# FFMPEG_THREADS=0            # 0 = let ffmpeg decide
# VIDEO_TIMEOUT_MINUTES=120   # a conversion that takes longer is cancelled

# Images are resized and converted to WebP with sharp (no extra install needed).
# IMAGE_MAX_WIDTH=1600        # pixels; smaller images are never enlarged
# IMAGE_QUALITY=80            # 1-100
# Optional: folder with the certificate fonts (manifest.json + .woff files).
# Default: <backend>/assets/certificate-fonts (relative to where the server is started).
# FONTS_DIR=

# Gmail: enable 2-Step Verification and use an App Password (not your Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# POK (https://docs.pok.tech): emite las credenciales digitales de los certificados.
# La API key se genera en POK > ajustes de usuario > Integrations. Es secreta.
POK_API_KEY=

POK_EMITTER=Campus Virtual
# Emision DIRECTA y silenciosa (valores por defecto): la credencial se emite al instante, POK no envia su correo
# y el estudiante no tiene que aceptarla; ve su enlace (viewUrl) en la plataforma. Cada uno se puede cambiar:
# POK_SAVE_AS_DRAFT=false        # true = queda en BORRADOR en POK (pruebas: no emite ni gasta creditos)
# POK_SKIP_EMISSION_EMAIL=true   # false = POK le envia su correo al estudiante
# POK_SKIP_ACCEPTANCE=true       # false = el estudiante debe aceptar la credencial desde el correo de POK
# Webhook de POK (POK > Webhooks > ícono de llave). Con la clave de firma se verifica el HMAC; si no, el secreto compartido.
# POK_WEBHOOK_SIGNING_KEY=
# POK_WEBHOOK_SECRET=
# POK_API_URL=https://api.pok.tech
# POK_LANGUAGE=es-AR

