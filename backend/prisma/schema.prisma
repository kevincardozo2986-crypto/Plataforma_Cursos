generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model User {
  id           Int        @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String     @unique
  passwordHash String
  document     String     @unique
  phone        String?
  role         Role       @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Cursos creados por este profesor
  courses Course[]

  enrollments           Enrollment[]
  evaluationAttempts    EvaluationAttempt[]
  assignmentSubmissions AssignmentSubmission[]
  notifications         Notification[]
  announcements         Announcement[]
  discussionPosts       DiscussionPost[]
  reviews               Review[]

  @@map("users")
}

model Course {
  id          Int          @id @default(autoincrement())
  title       String
  slug        String       @unique
  description String
  imageUrl    String?
  price       Decimal      @db.Decimal(10, 2)
  level       CourseLevel  @default(BEGINNER)
  status      CourseStatus @default(DRAFT)

  // Acceso y cupo
  visibility     CourseVisibility @default(PUBLIC)
  /// Hash bcrypt; solo se usa cuando visibility = PASSWORD. Nunca se devuelve.
  accessPassword String?
  maxStudents    Int?
  /// Contenido visible sin inscripción.
  publicContent  Boolean          @default(false)
  qaEnabled      Boolean          @default(true)

  // Presentación
  introVideoUrl String?

  // Resumen del curso (paso "Adicional")
  whatYouWillLearn String?
  audience         String?
  durationMinutes  Int?
  materials        String?
  requirements     String?

  teacherId Int
  teacher   User @relation(fields: [teacherId], references: [id])

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  modules         CourseModule[]
  enrollments     Enrollment[]
  announcements   Announcement[]
  discussionPosts DiscussionPost[]
  reviews         Review[]

  /// Cursos que hay que completar antes de inscribirse en este.
  requires   CoursePrerequisite[] @relation("CourseRequires")
  requiredBy CoursePrerequisite[] @relation("CourseRequiredBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([status])
  @@index([categoryId])
  @@map("courses")
}

enum CourseVisibility {
  PUBLIC
  PRIVATE
  PASSWORD
}

model CoursePrerequisite {
  courseId       Int
  course         Course @relation("CourseRequires", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisiteId Int
  prerequisite   Course @relation("CourseRequiredBy", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([courseId, prerequisiteId])
  @@map("course_prerequisites")
}

enum ResourceType {
  PDF
  VIDEO
  LINK
  DOCUMENT
  OTHER
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses Course[]

  @@map("categories")
}

model CourseModule {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  position    Int     @default(1)

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons     Lesson[]
  evaluations Evaluation[]
  assignments Assignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, position])
  @@map("modules")
}

model Lesson {
  id              Int     @id @default(autoincrement())
  title           String
  content         String?
  videoUrl        String?
  durationMinutes Int?
  position        Int     @default(1)

  moduleId Int
  module   CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  resources       Resource[]
  progress        LessonProgress[]
  discussionPosts DiscussionPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId, position])
  @@map("lessons")
}

model Resource {
  id    Int          @id @default(autoincrement())
  title String
  type  ResourceType @default(LINK)
  url   String

  lessonId Int
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lessonId])
  @@map("resources")
}

model Evaluation {
  id           Int     @id @default(autoincrement())
  title        String
  description  String?
  passingScore Int     @default(60)

  moduleId Int
  module   CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  questions Question[]
  attempts  EvaluationAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
  @@map("evaluations")
}

/// TRUE_FALSE y SINGLE: una opción correcta. MULTIPLE: varias correctas.
/// FILL_BLANK: cada opción es una respuesta aceptada (todas `isCorrect`).
/// ESSAY: respuesta abierta, sin opciones; la califica el docente a mano.
enum QuestionType {
  TRUE_FALSE
  SINGLE
  MULTIPLE
  FILL_BLANK
  ESSAY
}

/// PENDING_REVIEW: tiene preguntas abiertas sin calificar; la nota es provisional.
enum AttemptStatus {
  GRADED
  PENDING_REVIEW
}

model Question {
  id       Int          @id @default(autoincrement())
  text     String
  type     QuestionType @default(SINGLE)
  points   Int          @default(1)
  position Int          @default(1)

  evaluationId Int
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  options Option[]

  @@index([evaluationId, position])
  @@map("questions")
}

model Option {
  id        Int     @id @default(autoincrement())
  text      String
  isCorrect Boolean @default(false)

  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("options")
}

model EvaluationAttempt {
  id     Int     @id @default(autoincrement())
  score  Int
  passed Boolean
  answers Json

  status AttemptStatus @default(GRADED)
  /// Foto de la calificación al presentar: por pregunta, texto, tipo, puntos, acierto
  /// (null si es abierta) y puntos obtenidos. Así la revisión no depende de que el
  /// docente edite el quiz después.
  results Json?
  feedback String?
  gradedAt DateTime?
  /// Docente que calificó (sin relación, para no acoplar con el módulo de usuarios).
  gradedById Int?

  evaluationId Int
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([evaluationId, userId])
  @@index([status])
  @@map("evaluation_attempts")
}

/// Avisos que ve cada usuario en su campana de notificaciones.
enum NotificationType {
  ANNOUNCEMENT
  NEW_QUESTION
  NEW_REPLY
  NEW_REVIEW
}

/// Calificación (1 a 5) y comentario de un estudiante sobre un curso. Una por estudiante y curso.
model Review {
  id      Int     @id @default(autoincrement())
  rating  Int
  /// Texto plano.
  comment String?

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, userId])
  @@index([courseId, rating])
  @@map("reviews")
}

model Notification {
  id      Int              @id @default(autoincrement())
  type    NotificationType
  title   String
  message String?
  /// Curso y elemento a los que lleva el aviso (el frontend arma el enlace).
  courseId Int?
  refId    Int?
  readAt   DateTime?

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// Aviso del docente a los inscritos de un curso.
model Announcement {
  id    Int    @id @default(autoincrement())
  title String
  /// HTML ya sanitizado.
  body  String

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, createdAt])
  @@map("announcements")
}

/// QUESTION: pregunta del curso (P y R). COMMENT: comentario en una lección.
enum DiscussionKind {
  QUESTION
  COMMENT
}

/// Una publicación de la conversación del curso. Las raíces (parentId nulo) son preguntas o
/// comentarios; las respuestas apuntan a su raíz. Texto plano.
model DiscussionPost {
  id    Int            @id @default(autoincrement())
  kind  DiscussionKind
  /// Solo las preguntas llevan título.
  title String?
  body  String
  /// Una pregunta queda respondida cuando el docente del curso contesta.
  answered Boolean @default(false)

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessonId Int?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parentId Int?
  parent   DiscussionPost?  @relation("PostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  DiscussionPost[] @relation("PostReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, kind, parentId])
  @@index([lessonId, parentId])
  @@index([parentId])
  @@map("discussion_posts")
}

/// SUBMITTED: entregada, esperando nota. GRADED: calificada por el docente.
enum SubmissionStatus {
  SUBMITTED
  GRADED
}

/// Tarea calificable de un módulo (tercer tipo de ítem junto a lecciones y evaluaciones).
model Assignment {
  id          Int       @id @default(autoincrement())
  title       String
  /// HTML ya sanitizado.
  description String?
  dueAt       DateTime?
  /// false: pasada la fecha límite ya no se aceptan entregas.
  allowLate   Boolean   @default(true)
  maxScore    Int       @default(100)

  moduleId Int
  module   CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  submissions AssignmentSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
  @@map("assignments")
}

/// Una entrega por estudiante y tarea; se puede reenviar mientras no esté calificada.
model AssignmentSubmission {
  id    Int     @id @default(autoincrement())
  text  String?
  /// [{ name, originalName, size }]: archivos privados (ver módulo uploads).
  files Json    @default("[]")
  /// Entregada después de la fecha límite.
  late  Boolean @default(false)

  status   SubmissionStatus @default(SUBMITTED)
  score    Int?
  feedback String?
  gradedAt DateTime?
  /// Docente que calificó (sin relación, para no acoplar con el módulo de usuarios).
  gradedById Int?

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignmentId Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId])
  @@index([status])
  @@map("assignment_submissions")
}

model Enrollment {
  id          Int              @id @default(autoincrement())
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessonProgress LessonProgress[]

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  id          Int       @id @default(autoincrement())
  completedAt DateTime  @default(now())

  enrollmentId Int
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  lessonId Int
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@map("lesson_progress")
}
