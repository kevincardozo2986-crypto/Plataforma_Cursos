# Dentro del bloque server de tu dominio. Frontend SSR: puerto 4000; Nest: 3000.
location = /cursos_virtuales_mooc {
    return 301 /cursos_virtuales_mooc/;
}

location /cursos_virtuales_mooc/api/ {
    # La barra final elimina /cursos_virtuales_mooc/api/ antes de llegar a Nest.
    proxy_pass http://127.0.0.1:3000/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # Debe coincidir con el límite de archivos definido en el backend.
    client_max_body_size 500m;
}

location /cursos_virtuales_mooc/ {
    # Sin barra final: conserva el prefijo para Angular SSR.
    proxy_pass http://127.0.0.1:4000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
